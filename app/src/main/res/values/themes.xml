<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Encryptor255" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary terracota -->
        <item name="colorPrimary">@color/terracotta</item>
        <item name="colorOnPrimary">@color/warm_950</item>
        <item name="colorPrimaryContainer">@color/terracotta_dark</item>
        <item name="colorOnPrimaryContainer">@color/terracotta_light</item>

        <!-- Secondary warm tan -->
        <item name="colorSecondary">@color/violet_500</item>
        <item name="colorOnSecondary">@color/warm_950</item>
        <item name="colorSecondaryContainer">@color/violet_600</item>
        <item name="colorOnSecondaryContainer">@color/violet_400</item>

        <item name="colorTertiary">@color/warning</item>
        <item name="colorOnTertiary">@color/warm_950</item>

        <!-- Superficies warm -->
        <item name="android:colorBackground">@color/warm_900</item>
        <item name="colorSurface">@color/warm_800</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/warm_700</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceInverse">@color/warm_600</item>
        <item name="colorOutline">@color/divider_strong</item>
        <item name="colorOutlineVariant">@color/divider</item>

        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/warm_950</item>

        <!-- Sistema -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/warm_900</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- ════════ TIPOGRAFÍA CLAUDE ════════ -->

    <style name="TextAppearance.Encryptor.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:letterSpacing">0.0</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Encryptor.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:letterSpacing">0.005</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="TextAppearance.Encryptor.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- ════════ SPLASH ════════ -->

    <style name="Theme.Encryptor255.Splash" parent="Theme.Encryptor255">
        <item name="android:windowBackground">@drawable/bg_splash</item>
    </style>

    <style name="Theme.Encryptor255.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/warm_950</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/Theme.Encryptor255</item>
    </style>
</resources>

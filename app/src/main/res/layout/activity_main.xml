<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_root"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="60dp"
        android:paddingBottom="56dp">

        <!-- ═══════════ TOP BAR ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌘"
                android:textSize="20sp"
                android:textColor="@color/terracotta"
                android:fontFamily="monospace" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/app_name"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:letterSpacing="0.01"
                android:fontFamily="sans-serif-medium" />

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/cd_settings"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/badgeOffline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_offline"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/badge_offline"
                android:textSize="9sp"
                android:letterSpacing="0.10"
                android:textColor="@color/terracotta"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/divider_hairline" />

        <!-- ═══════════ TAGLINE ═══════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/tagline"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_tertiary"
            android:fontFamily="monospace" />

        <!-- ═══════════ PASSWORD CARD ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_password"
                    android:textSize="10sp"
                    android:letterSpacing="0.18"
                    android:textColor="@color/text_tertiary"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/strengthLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/strength_empty"
                    android:textSize="10sp"
                    android:textColor="@color/text_tertiary"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/hint_password"
                    android:textColorHint="@color/text_tertiary"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:importantForAutofill="no"
                    android:fontFamily="monospace" />

                <ImageButton
                    android:id="@+id/btnTogglePwd"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_eye_on"
                    android:contentDescription="@string/cd_show_pwd"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnGenerate"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_dice"
                    android:contentDescription="@string/cd_generate"
                    android:scaleType="centerInside" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_strength_track">

                <View
                    android:id="@+id/strengthBar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_strength_fill" />
            </FrameLayout>
        </LinearLayout>

        <!-- ═══════════ SEGMENTED CONTROL ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_segment_track"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tabText"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_segment_selected"
                android:text="@string/tab_text"
                android:textSize="12sp"
                android:letterSpacing="0.04"
                android:textColor="@color/text_primary"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tabFile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/tab_file"
                android:textSize="12sp"
                android:letterSpacing="0.04"
                android:textColor="@color/text_secondary"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- ═══════════ CONTENIDO TEXTO ═══════════ -->
        <LinearLayout
            android:id="@+id/containerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_content"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:textColor="@color/text_tertiary"
                android:fontFamily="monospace" />

            <EditText
                android:id="@+id/textInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@null"
                android:hint="@string/hint_content"
                android:textColorHint="@color/text_tertiary"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:lineSpacingExtra="5dp"
                android:minLines="7"
                android:gravity="top|start"
                android:inputType="textMultiLine|textNoSuggestions"
                android:importantForAutofill="no"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ═══════════ CONTENIDO ARCHIVO ═══════════ -->
        <LinearLayout
            android:id="@+id/containerFile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_glass"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ARCHIVO"
                android:textSize="10sp"
                android:letterSpacing="0.18"
                android:textColor="@color/text_tertiary"
                android:fontFamily="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_card_accent">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_document"
                        android:contentDescription="@string/tab_file" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/fileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hint_no_file"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:fontFamily="monospace"
                        android:maxLines="1"
                        android:ellipsize="middle" />

                    <TextView
                        android:id="@+id/fileMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="—"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/btnPickFile"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/action_pick_file"
                android:textSize="12sp"
                android:textColor="@color/terracotta"
                android:letterSpacing="0.10"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- ═══════════ ACCIONES ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEncrypt"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_primary"
                android:text="@string/action_encrypt"
                android:textSize="13sp"
                android:textColor="@color/warm_950"
                android:letterSpacing="0.10"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/btnDecrypt"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/action_decrypt"
                android:textSize="13sp"
                android:textColor="@color/terracotta"
                android:letterSpacing="0.10"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- ═══════════ UTILIDADES ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_ghost"
                android:src="@drawable/ic_copy"
                android:contentDescription="@string/cd_copy"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_ghost"
                android:src="@drawable/ic_share"
                android:contentDescription="@string/cd_share"
                android:scaleType="centerInside" />

            <ImageButton
                android:id="@+id/btnClear"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_ghost"
                android:src="@drawable/ic_clear"
                android:contentDescription="@string/cd_clear"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- ═══════════ TERMINAL LOG ═══════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_terminal"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/dot_status" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="@string/label_terminal"
                    android:textSize="10sp"
                    android:letterSpacing="0.16"
                    android:textColor="@color/terminal_dim"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/hashLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="9sp"
                    android:textColor="@color/terminal_dim"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/status_ready"
                android:textColor="@color/terminal_text"
                android:textSize="12sp"
                android:lineSpacingExtra="5dp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- ═══════════ FOOTER ═══════════ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/divider_hairline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/footer_version"
            android:textColor="@color/text_tertiary"
            android:textSize="10sp"
            android:letterSpacing="0.10"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="@string/footer_note"
            android:textColor="@color/text_disabled"
            android:textSize="10sp"
            android:fontFamily="monospace" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>

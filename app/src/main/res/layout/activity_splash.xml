<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="40dp"
        android:paddingEnd="40dp">

        <ImageView
            android:id="@+id/splashIcon"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:src="@drawable/splash_icon"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="ENCRYPTOR"
            android:textSize="12sp"
            android:letterSpacing="0.42"
            android:textColor="#00E5FF"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="255"
            android:textSize="46sp"
            android:textStyle="bold"
            android:textColor="#E8F4FF"
            android:letterSpacing="0.06"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-black" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="CIFRADO CUÁNTICO LOCAL"
            android:textSize="10sp"
            android:letterSpacing="0.32"
            android:textColor="#4D6480"
            android:fontFamily="sans-serif-medium" />

        <View
            android:id="@+id/splashBar"
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:layout_marginTop="36dp"
            android:background="#00E5FF" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="38dp"
        android:gravity="center"
        android:text="AES-256-GCM · PBKDF2-SHA512 310K · GZIP"
        android:textSize="9sp"
        android:letterSpacing="0.24"
        android:textColor="#2A3A52"
        android:fontFamily="monospace" />
</FrameLayout>
